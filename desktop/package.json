{
  "name": "vora-desktop",
  "version": "1.0.1",
  "description": "VORA ERP & POS Desktop Shell (Windows Portable)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.venesoftca.vora.desktop",
    "productName": "VORA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "VORA-Portable-${version}-${arch}.exe"
    }
  }
}
