# =====================================================================
#  VORA — Environment Variables Example
#  Copy this file to .env and fill in your values.
# =====================================================================

# ---- Platform Supabase (shared, public) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Platform Supabase (server-only, secret) ----
# NEVER expose this in the browser. Used by API routes for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Demo requests: Resend (server-only) ----
# Set in Vercel Production, then redeploy. Verify the sending domain in Resend.
# Notifications always go to info@venesoftca.com; Reply-To is the applicant.
RESEND_API_KEY=
DEMO_REQUEST_FROM=VORA <avisos@notificaciones.venesoftca.com>

# ---- Tenant DB connections (server-only, never use NEXT_PUBLIC_ prefix) ----
# Each tenant gets its own existing Supabase project. The platform stores only
# the project_ref, URL, and an opaque secret_ref. The variable named by
# secret_ref must contain the tenant service-role key and must remain server-only.
# Example after choosing secret_ref=TENANT_SOLEE_SERVICE_KEY:
# TENANT_SOLEE_SERVICE_KEY=tenant-service-role-key
# Adding or changing a tenant key requires a redeploy of the platform application.
